&control
  calculation = 'scf'
  prefix = 'te_eps+0.00000_cut1'
  pseudo_dir = '../pseudopotentials/'
  outdir = './tmp'
  verbosity = 'high'
  tstress = .true.
  tprnfor = .true.
/
&system
  ibrav = 4
  celldm(1) = 8.42061962
  celldm(3) = 1.33011670
  nat = 3
  ntyp = 1
  ecutwfc = 60
  ecutrho = 480
  noncolin = .true.
  lspinorb = .true.
  occupations = 'smearing'
  smearing = 'gaussian'
  degauss = 0.005
/
&electrons
  conv_thr = 1.0d-9
  mixing_beta = 0.3
/
ATOMIC_SPECIES
  Te  127.60  Te.rel-pbe-n-rrkjus_psl.1.0.0.UPF
ATOMIC_POSITIONS crystal
  Te   0.2690   0.0000   0.6667
  Te   0.0000   0.2690   0.3333
  Te  -0.2690  -0.2690   0.0000
K_POINTS automatic
  6 6 4 0 0 0
