&control
  calculation  = 'scf'
  prefix       = 'te0_conv'
  pseudo_dir   = '/home/user/workspace/qe_runs/pseudo'
  outdir       = '/home/user/workspace/qe_runs/strain_0/conv_out'
  verbosity    = 'high'
  tstress      = .true.
/
&system
  ibrav       = 0
  nat         = 3
  ntyp        = 1
  ecutwfc     = 70.0
  ecutrho     = 560.0
  noncolin     = .true.
  lspinorb     = .true.
  occupations  = 'smearing'
  smearing     = 'gauss'
  degauss      = 0.01
  nspin        = 4
/
&electrons
  conv_thr     = 1.0D-8
  mixing_beta  = 0.4
  diagonalization = 'david'
  diago_thr_init = 1.0D-5
/
