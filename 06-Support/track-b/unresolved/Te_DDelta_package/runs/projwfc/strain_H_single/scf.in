&control
 calculation  = 'scf'
 prefix       = 'teH'
 pseudo_dir   = '/home/user/workspace/qe_runs/pseudo'
 outdir       = '/home/user/workspace/qe_runs/strain_H_single/out'
 verbosity    = 'low'
/
&system
 ibrav       = 0
 nat          = 3
 ntyp         = 1
 noncolin     = .true.
 lspinorb     = .true.
 ecutwfc      = 50
 ecutrho      = 300
 nbnd         = 28
 occupations  = 'smearing'
 smearing     = 'gauss'
 degauss      = 0.01
/
&electrons
 conv_thr     = 1.0d-8
 mixing_beta  = 0.7
/
